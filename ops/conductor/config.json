{
  "repo": "ahlerjam/academic-research",
  "base": "main",
  "head_prefix": "claude/",
  "unit_branch_prefix": "claude/unit-",
  "required_checks": ["gate", "protect"],
  "status_title": "Conductor status",
  "inbox_title": "Operator-Inbox",
  "state_branch": "conductor/state",
  "progress_path": "docs/autonomy/progress.json",
  "lease_max_age_s": 7200,
  "wip_max": 2,
  "wip_start": 1,
  "stages": ["1", "2a", "2b", "3", "4", "5"],
  "slices": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9"],
  "workflows": {
    "build": "ar-unit",
    "spike": "ar-spike",
    "plan": "ar-plan",
    "fix": "ar-fix",
    "rebase": "ar-fix",
    "judge": "ar-judge",
    "critic": "ar-critic",
    "triage": "ar-triage",
    "proof": "ar-judge"
  },
  "team_tag": "contract-team",
  "team_workflow": "ar-team",
  "issue_only_kinds": ["plan", "judge", "critic", "triage", "proof"],
  "proof_workflow": "proof.yml",
  "release_workflow": "release.yml",
  "release_version": "0.1.0",
  "changelog_path": "CHANGELOG.md",
  "verdict_path": "docs/release/{version}.md",
  "forecast_window_days": 7,
  "body_max_chars": 60000
}

{
  "name": "academic-research",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24.14 <25"
  },
  "scripts": {
    "fix": "prettier --write . && eslint --fix .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p packages/core --pretty false && tsc -p packages/server --pretty false && tsc -p packages/web --pretty false",
    "test": "vitest run",
    "build": "pnpm -r run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}

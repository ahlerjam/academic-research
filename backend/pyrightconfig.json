{
  "include": ["app", "tests"],
  "exclude": ["**/__pycache__", ".venv", "gates"],
  "typeCheckingMode": "strict",
  "pythonVersion": "3.14",
  "venvPath": ".",
  "venv": ".venv",
  "reportMissingTypeStubs": true,
  "reportImplicitOverride": "error",
  "enableTypeIgnoreComments": false,
  "reportUnnecessaryTypeIgnoreComment": "error"
}
